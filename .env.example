# DevOpsHub Environment Variables
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./prisma/dev.db" # or postgresql://user:pass@localhost:5432/devopshub
JWT_SECRET="devopshub_super_secret_jwt_key_2026_change_in_prod"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
JENKINS_URL="http://localhost:8080" # Optional: leave empty for Demo Mode
JENKINS_USER="admin"
JENKINS_TOKEN="jenkins_api_token"
GITHUB_WEBHOOK_SECRET="devopshub_webhook_secret_key"
